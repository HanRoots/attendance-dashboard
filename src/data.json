      "methods": [
        {
          "language": "javascript",
          "code": "按学生汇总教学周；出勤率 = 出勤教学周 ÷ 应统计教学周。"
        }
      ],
      "source": {
        "label": "匿名示例课程记录",
        "files": [
          "示例课消.xlsx"
        ],
        "evidenceFlow": [
          {
            "title": "读取 Excel",
            "detail": "读取工作表“消课记录”，按列名映射日期、学生、班级和课时字段。"
          },
          {
            "title": "划分教学周",
            "detail": "将每条消课记录归入其所在的周五至次周周四周期。"
          },
          {
            "title": "计算出勤",
            "detail": "同一学生在同一教学周内至少有一条消课记录即计为出勤一次；多条记录仍只计一个出勤教学周。"
          }
        ],
        "caveats": [
          "统计区间从首条消课记录所在教学周开始，到最后一条消课记录所在教学周结束。源文件未提供节假日或停课表；可在“假期设置”中添加区间，将相交且无上课记录的教学周排除出出勤率。"
        ],
        "metricDefinitions": [
          {
            "label": "出勤率",
            "definition": "出勤教学周数除以统计区间内应统计教学周数；自定义放假周不计入分母。",
            "formula": "attendedWeeks / expectedWeeks",
            "dependencies": [
              "attendedWeeks",
              "expectedWeeks"
            ],
            "componentIds": [
              "attendance-rate"
            ]
          },
          {
            "label": "出勤教学周",
            "definition": "至少存在一条消课记录的周五至次周周四周期数。",
            "componentIds": [
              "attended-weeks"
            ]
          },
          {
            "label": "缺勤教学周",
            "definition": "统计区间内没有消课记录、且未被自定义假期排除的周五至次周周四周期数。",
            "componentIds": [
              "absent-weeks"
            ]
          },
          {
            "label": "累计消课",
            "definition": "统计区间内所有消课记录的消课时数之和。",
            "componentIds": [
              "consumed-hours"
            ]
          },
          {
            "label": "连续出勤",
            "definition": "截至最后一个已纳入教学周，连续出勤的教学周数。",
            "componentIds": [
              "current-streak"
            ]
          }
        ]
      }
